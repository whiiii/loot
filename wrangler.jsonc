{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // The Worker runs before the static files.
  //
  // By default Cloudflare serves the public folder's files straight from
  // the edge and the Worker never sees those requests. That will not do on
  // this site: everything is behind a shared password, and the gate cannot
  // be guarded if pages open past it.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,

    // Files are served under exactly the name they are asked for.
    //
    // By default Cloudflare redirects '/gate.html' to '/gate'. When the
    // Worker asked for the file by name, it got a redirect back, routed
    // that through its own routing and ended up in a loop. The routes are
    // decided here, so the file server must not invent its own.
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // D1 is SQLite. database_id is filled in once the database exists.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loot-db",
      "database_id": "3354971d-05a8-47f2-8af2-66ea7f9176fb"
    }
  ]
}
